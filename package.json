{
  "name": "personal-ai",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "db:local": "wrangler d1 migrations apply personal-ai-db --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "miniflare": "^5.20261023.0-beta",
    "wrangler": "^4.153.0"
  }
}
